{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/cron/daily.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 6 * * *" }
  ]
}
