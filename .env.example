# Server
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Database (Railway Postgres)
DATABASE_URL=

# Auth
JWT_SECRET=
# Credentials for the one admin account `npm run seed` creates. Change
# these before running seed if you don't want the defaults.
SEED_ADMIN_EMAIL=admin@nayaglows.com
SEED_ADMIN_PASSWORD=changeme123

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Fixed USD->NGN conversion used to price orders (Paystack charges in NGN).
# No live FX API yet — update this manually as rates move.
USD_TO_NGN_RATE=1600

# Cloudinary (image uploads — admin product/content images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (OTP codes, order confirmation, consultation/wholesale
# notifications) — sent via Resend's HTTP API (see backend/RESEND_SETUP.md).
# Leave RESEND_API_KEY blank to skip sending — emails are logged instead of
# thrown as errors.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Naya Glows <no-reply@nayaglows.skin>"
# Where consultation/wholesale notifications go. Defaults to SEED_ADMIN_EMAIL.
ADMIN_NOTIFICATION_EMAIL=
