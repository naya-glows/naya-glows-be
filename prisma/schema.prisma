generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (PgBouncer, transaction mode) doesn't support
  // the prepared statements `prisma migrate deploy` needs — directUrl
  // routes migrations through the unpooled connection instead, while the
  // app's own runtime queries still go through the pooled `url` above.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  CUSTOMER
  INFLUENCER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable — customers authenticate via email OTP now and never set one;
  // only admin accounts (created by `npm run seed`) still have a real hash.
  passwordHash String?
  firstName    String
  lastName     String
  role         Role     @default(CUSTOMER)
  country      String?
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  savedProducts SavedProduct[]
  cart          Cart?
  productSubscriptions ProductSubscription[]
  subscriptionPlans    SubscriptionPlan[]
  kitEnrollments       KitEnrollment[]

  // Present only on INFLUENCER-role users.
  influencer Influencer?

  // Set when this user signed up using another influencer's referral code.
  referredByCodeId String?
  referredByCode    ReferralCode? @relation("ReferredSignups", fields: [referredByCodeId], references: [id])
}

// One row per (email, purpose) — a new request overwrites the previous code
// rather than accumulating rows, so a resend always invalidates the prior
// one. "SIGNUP" is the only purpose today; the field exists so the same
// table can serve e.g. password-reset codes later without a migration.
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, purpose])
}

// A signed-in customer's cart, mirrored server-side purely so the backend
// can know what's in it — the frontend (cartSlice.ts) remains the actual
// source of truth for the live shopping experience; this is a snapshot
// synced on every change, used only to find abandoned carts to email about.
model Cart {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  items          Json
  updatedAt      DateTime  @updatedAt
  // Reset to null whenever items change, so a new abandonment period can
  // trigger a fresh reminder rather than firing only once ever.
  reminderSentAt DateTime?
}

model Influencer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Stored uppercased — the prefix every one of this influencer's referral
  // codes starts with (e.g. "STARGIRL" -> "STARGIRL4Z5OA3E2"), unique so two
  // influencers never share confusingly similar-looking codes.
  codeName        String  @unique
  twitterHandle   String?
  instagramHandle String?
  tiktokHandle    String?
  bio             String?
  createdAt       DateTime @default(now())

  referralCodes ReferralCode[]
}

model ReferralCode {
  id           String     @id @default(cuid())
  code         String     @unique
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  createdAt    DateTime   @default(now())

  referredUsers User[] @relation("ReferredSignups")
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  categoryAccent String?
  price         Float
  originalPrice Float
  image         String
  tagline       String
  description   String
  benefits      String[]
  // Optional size/variant pricing, e.g. [{"name":"Small","price":6.25},{"name":"Big","price":9.38}].
  // When set, the storefront requires picking one and its price overrides
  // the base `price` above; when null/empty the product is single-priced.
  variants      Json?
  isActive      Boolean  @default(true)
  inStock       Boolean  @default(true)
  // Set only on the synthetic Product row a Combo upserts for itself (see
  // Combo below) — lets order/email/tracking code that expects a real
  // Product keep working unmodified for a bundle, while still being able to
  // tell "this line item is actually a combo" apart from a retail product
  // when it matters (e.g. admin order detail).
  isCombo          Boolean  @default(false)
  comboProductSlugs String[] @default([])
  // Same convention as isCombo, for the synthetic Product row a
  // TreatmentKit upserts for itself (see TreatmentKit below) — lets a kit
  // purchase flow through cart/checkout unmodified, while payments.service.ts
  // can tell "this line item is a kit" apart to create its KitEnrollment.
  isKit         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
  savedByUsers  SavedProduct[]
  subscriptions ProductSubscription[]
}

// An admin-defined bundle of 2+ existing products sold as one fixed-price
// item (e.g. "Ambrosia combo"). Kept as its own model (name, description,
// cover image, which products) so the admin UI has a clean place to manage
// it, but every Combo also upserts a matching Product row (slug-matched,
// isCombo: true) the moment it's created/updated — that's what actually
// lets it be added to cart, checked out, paid for, tracked, and shown in
// order history through the exact same pipeline as any other product,
// with zero changes to cartSlice, createOrder, email templates, or the
// admin orders page.
model Combo {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  coverImage   String?
  price        Float
  productSlugs String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A time-boxed discount campaign (Black Friday, Independence Day, etc.) —
// reusable season to season per the brief's own requirement ("not
// permanently tied to Black Friday"). `productSlugs` empty means storewide;
// otherwise only those products/combos show the discount and appear on the
// campaign's own landing page at /sale/[slug].
model SeasonalSale {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  discountPercent Float
  productSlugs    String[] @default([])
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  bannerHeadline  String
  bannerCopy      String
  bannerImage     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Config for the seasonal promotional pop-up + spin-to-win mechanic —
// everything the brief asks to be editable without a rebuild (graphic,
// copy, prize odds, dates, social links, popup frequency) lives here as one
// admin-managed row per campaign.
model Campaign {
  id                String   @id @default(cuid())
  name              String
  isActive          Boolean  @default(false)
  startDate         DateTime
  endDate           DateTime
  popupHeadline     String
  popupCopy         String
  popupImage        String?
  ctaText           String
  // Where "browse and purchase" sends the visitor after claiming a prize —
  // normally a SeasonalSale's slug, e.g. "/sale/black-friday".
  landingPath       String
  // [{ label, weight, rewardType: "discount_code" | "message", rewardValue }]
  prizes            Json
  // [{ platform, url }]
  socialLinks       Json
  // Don't show the popup again to the same visitor for this many days after
  // it's been shown/dismissed once (brief: "frequency controls").
  popupFrequencyDays Int     @default(7)
  consentText       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leads Lead[]
}

// A spin-to-win lead — captured once, exportable by admin (brief: "leads
// are exportable"). Not linked to a User; this is a marketing capture, not
// an account, since the visitor hasn't signed up for anything yet.
model Lead {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  fullName     String
  phone        String
  address      String
  email        String?
  socialHandle String?
  prizeWon     String
  consentGiven Boolean  @default(false)
  createdAt    DateTime @default(now())
}

enum KitEnrollmentStatus {
  ACTIVE
  EXPIRED
}

// The four curated subscription/treatment packages (Bronze/Silver/Gold/
// Premium) from the brief — admin-editable per requirement 7 ("package
// pricing through the website admin/CMS"), distinct from the existing
// Subscribe & Save (SubscriptionPlan/ProductSubscription) system since
// these are fixed service packages, not a build-your-own product bundle.
model TreatmentKit {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  durationMonths Int
  price          Float
  // Plain bullet points — e.g. Premium's final, client-supplied copy is
  // "12 Months of Skincare Supply", "3 Months of Complimentary Spa
  // Experiences", "3 Months of Skin Specialist Support" (positioned as
  // ongoing guidance, not formal consultation appointments). Kept as free
  // text rather than separate structured fields (an earlier draft of this
  // schema had extraMonths/consultationEveryMonths/specialistAccessMonthly)
  // since the real benefits turned out to vary in shape per package and
  // read better as plain bullets anyway.
  benefits  String[]
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments KitEnrollment[]
}

// A customer's purchase of a TreatmentKit — tracks the ongoing service
// window (consultation access, specialist check-ins) a kit purchase
// entitles them to, separate from the one-time Order that captured payment.
model KitEnrollment {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  kitId     String
  kit       TreatmentKit        @relation(fields: [kitId], references: [id])
  orderId   String
  startDate DateTime            @default(now())
  endDate   DateTime
  status    KitEnrollmentStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
}

// Black Friday Early Reservation — a fixed-content kit catalog (real client
// copy: Spot Fade Kit, Acne Clear + Fade Kit, Body Glow Set), reservable with
// a ₦5,000 deposit now, balance due on a fixed date (Black Friday itself).
// Kept entirely separate from Combo/TreatmentKit since the two-stage
// deposit-then-balance payment flow is unique to this feature.
model ReservationKit {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  totalPrice   Float
  depositAmount Float
  // The public (non-reserved) Black Friday price, shown struck through next
  // to the reservation price when it's higher — e.g. Body Glow Set's
  // "₦3,000 less than the public Black Friday price of ₦63,000". Null when
  // there's no separate public price to compare against.
  publicPrice  Float?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations KitReservation[]
}

enum KitReservationStatus {
  RESERVED
  BALANCE_PAID
  CANCELLED
}

model KitReservation {
  id        String         @id @default(cuid())
  kitId     String
  kit       ReservationKit @relation(fields: [kitId], references: [id])
  fullName  String
  email     String
  phone     String
  depositAmount    Float
  depositPaid      Boolean   @default(false)
  depositReference String?   @unique
  balanceAmount    Float
  balanceDueDate   DateTime
  balancePaid      Boolean   @default(false)
  balanceReference String?   @unique
  status    KitReservationStatus @default(RESERVED)
  createdAt DateTime             @default(now())
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// Operational config (FX rate, subscription discount, etc.) — separate from
// ContentBlock, which is marketing copy. Missing keys mean "use the
// hardcoded default", same fallback philosophy as everything else.
model Setting {
  key   String @id
  value String
}

// Generic override store for site content sections (hero copy, testimonials, etc.)
// Keyed by a section identifier, e.g. "home.hero". Missing keys mean "use the
// hardcoded frontend default" — this table only ever holds overrides.
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

// Schema only for now — populated once the Paystack phase is built.
model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  currency        String      @default("USD")
  subtotal        Float
  shipping        Float       @default(0)
  total           Float
  // GLOW15 (or any future code) — set at order-creation time so the exact
  // code+amount actually applied is on permanent record, independent of
  // whatever the promo/validity rules say later.
  discountCode    String?
  discountAmount  Float       @default(0)
  shippingDetails Json?
  paidAt          DateTime?
  // Set when any refund (full or partial) has been issued — see Payment's
  // refundedAmount for how much. status flips to REFUNDED only once the
  // refunded amount covers the full total; a partial refund keeps status
  // PAID so fulfillment/tracking isn't disturbed.
  refundedAt      DateTime?
  // Admin manual override of the tracking stage — when set, overrides the
  // automatic time-based simulation in tracking.ts.
  manualStage     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Set on the original prepay order AND every later auto-created monthly
  // shipment order for a "recurring" Subscription B plan — lets the admin
  // trace every shipment back to the plan it belongs to.
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  qty            Int
  price          Float
  isSubscription Boolean @default(false)
  variantName    String?
}

// "Subscription A" — a standing, reusable discount unlocked on ONE specific
// product once the customer has bought it at full price. Applied via the
// `code` at checkout (not auto-detected from the account) so it works
// identically for a web order or an Instagram DM order a staff member
// enters manually — the code is the one thing that travels across both
// channels. Reusable indefinitely, not single-use: "every purchase after
// the first one" per the business rule this implements.
model ProductSubscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  code            String   @unique
  discountPercent Float
  // The order that qualified the customer for this (their first, full-price
  // purchase of this product) — informational, not required for redemption.
  firstOrderId    String?
  createdAt       DateTime @default(now())

  @@unique([userId, productId])
}

enum SubscriptionTerm {
  THREE_MONTH
  SIX_MONTH
  TWELVE_MONTH
}

enum SubscriptionPlanStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

// "Subscription B" — a prepaid multi-month plan (3/6/12 months) at a
// bigger, term-scaled discount, charged as one upfront payment. Both
// `fulfillmentMode` and `discountPercent` are snapshotted from the admin's
// settings at the moment of purchase, so a later admin change never
// retroactively alters an already-active plan.
model SubscriptionPlan {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  term    SubscriptionTerm
  // "immediate" (the whole term ships in this one order) or "recurring"
  // (ships one month at a time — see jobs/subscriptionShipments.ts).
  fulfillmentMode String
  // [{ slug, name, qtyPerMonth }] — what they subscribed to and at what
  // monthly quantity; the basis for the cost/discount calculation.
  items              Json
  discountPercent    Float
  totalPaid          Float
  status             SubscriptionPlanStatus @default(ACTIVE)
  // The Order that captured the upfront payment (for "immediate", also the
  // order carrying the full shipped quantity).
  orderId            String?
  // Only meaningful for "recurring": how many more monthly shipments are
  // owed, and when the next one is due. Both null/0 for "immediate".
  remainingShipments Int                    @default(0)
  nextShipmentDate   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  orders Order[]
}

// The two bookable services from the client's final brief — Standard
// (₦10,000/30min) and Extended (₦20,000, duration admin-set since the brief
// didn't give an exact figure for "Extended session").
model ConsultationType {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  feeNgn          Int
  durationMinutes Int
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)

  requests ConsultationRequest[]
}

// Admin-set unavailability — a whole day (startTime/endTime both null) or a
// specific time range within a day, per "Allow us to block off dates or
// time slots when we are unavailable."
model ConsultationBlock {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
}

model ConsultationRequest {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String?
  skinConcern   String
  preferredDate DateTime?
  message       String?
  status        String    @default("NEW")
  createdAt     DateTime  @default(now())

  // The brief asks for a paid, prominent booking step rather than a free
  // inquiry — reuses paystack.ts's initializeTransaction/verifyTransaction
  // directly (provider-agnostic) rather than the Order-coupled Payment
  // model, since this is a public/unauthenticated flow with no Order behind
  // it. feeNgn/durationMinutes are snapshotted from the chosen
  // ConsultationType at booking time, same reasoning as SubscriptionPlan's
  // own snapshotting — a later admin price change shouldn't retroactively
  // alter an already-booked appointment.
  feeNgn          Int     @default(10000)
  paymentReference String? @unique
  paid            Boolean @default(false)

  consultationTypeId String?
  consultationType   ConsultationType? @relation(fields: [consultationTypeId], references: [id])
  // The actual booked slot's start time — distinct from `preferredDate`,
  // which predates the real calendar and is now just a legacy free-text
  // hint kept for old rows.
  scheduledDate   DateTime?
  durationMinutes Int?
  // Short, human-readable code shown on the confirmation page/email and
  // usable as a support reference ("generate a booking reference for each
  // appointment").
  bookingReference String? @unique
}

enum BusinessInquiryType {
  WHOLESALE
  CORPORATE_GIFTING
  WHITE_LABEL
}

model WholesaleInquiry {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String?
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())

  // Generalized to cover all three business-enquiry directory entries from
  // the brief (Wholesale, Corporate Gifting, White-Label) sharing one model
  // and one admin inbox rather than three near-identical tables.
  type              BusinessInquiryType @default(WHOLESALE)
  estimatedQuantity String?
  budget            String?
  // Corporate Gifting-specific ("deadline for gifting") — null for the
  // other two types.
  deadline          DateTime?

  // White-Label-specific: a ₦50,000 product-development consultation fee
  // paid before we proceed. feeNgn is set at creation time (WHITE_LABEL
  // only); Wholesale/Corporate Gifting leave it null and paid stays false
  // forever, same no-payment story as reservations/consultations.
  feeNgn            Int?
  paid              Boolean  @default(false)
  paymentReference  String?  @unique
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A log of admin-sent email blasts — not a scheduler, just a record.
model EmailCampaign {
  id             String   @id @default(cuid())
  subject        String
  html           String
  recipientCount Int
  // "subscribers" (newsletter opt-ins) or "allUsers" (every registered
  // account) — which list this send actually went to.
  audience       String   @default("subscribers")
  createdAt      DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// Schema only for now — populated once the Paystack phase is built.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("paystack")
  providerReference String?       @unique
  amount            Float
  currency          String
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  // How much of `amount` has been refunded via Paystack's refund API so
  // far (0 if none) — tracked separately from `amount` so a partial
  // refund doesn't lose the original charge amount.
  refundedAmount    Float         @default(0)
  refundedAt        DateTime?
}

// Manual admin-entered expense/income lines for the budget tracker (later phase).
model BudgetEntry {
  id          String   @id @default(cuid())
  label       String
  amount      Float
  type        String // "income" | "expense"
  note        String?
  createdAt   DateTime @default(now())
}
