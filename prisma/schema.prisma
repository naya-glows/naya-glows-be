generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  INFLUENCER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  country      String?
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  savedProducts SavedProduct[]
  cart          Cart?
  productSubscriptions ProductSubscription[]
  subscriptionPlans    SubscriptionPlan[]

  // Present only on INFLUENCER-role users.
  influencer Influencer?

  // Set when this user signed up using another influencer's referral code.
  referredByCodeId String?
  referredByCode    ReferralCode? @relation("ReferredSignups", fields: [referredByCodeId], references: [id])
}

// One row per (email, purpose) — a new request overwrites the previous code
// rather than accumulating rows, so a resend always invalidates the prior
// one. "SIGNUP" is the only purpose today; the field exists so the same
// table can serve e.g. password-reset codes later without a migration.
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, purpose])
}

// A signed-in customer's cart, mirrored server-side purely so the backend
// can know what's in it — the frontend (cartSlice.ts) remains the actual
// source of truth for the live shopping experience; this is a snapshot
// synced on every change, used only to find abandoned carts to email about.
model Cart {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  items          Json
  updatedAt      DateTime  @updatedAt
  // Reset to null whenever items change, so a new abandonment period can
  // trigger a fresh reminder rather than firing only once ever.
  reminderSentAt DateTime?
}

model Influencer {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  platform     String?
  socialHandle String?
  bio          String?
  createdAt    DateTime @default(now())

  referralCodes ReferralCode[]
}

model ReferralCode {
  id           String     @id @default(cuid())
  code         String     @unique
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  createdAt    DateTime   @default(now())

  referredUsers User[] @relation("ReferredSignups")
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  categoryAccent String?
  price         Float
  originalPrice Float
  image         String
  tagline       String
  description   String
  benefits      String[]
  // Optional size/variant pricing, e.g. [{"name":"Small","price":6.25},{"name":"Big","price":9.38}].
  // When set, the storefront requires picking one and its price overrides
  // the base `price` above; when null/empty the product is single-priced.
  variants      Json?
  isActive      Boolean  @default(true)
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
  savedByUsers  SavedProduct[]
  subscriptions ProductSubscription[]
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// Operational config (FX rate, subscription discount, etc.) — separate from
// ContentBlock, which is marketing copy. Missing keys mean "use the
// hardcoded default", same fallback philosophy as everything else.
model Setting {
  key   String @id
  value String
}

// Generic override store for site content sections (hero copy, testimonials, etc.)
// Keyed by a section identifier, e.g. "home.hero". Missing keys mean "use the
// hardcoded frontend default" — this table only ever holds overrides.
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Schema only for now — populated once the Paystack phase is built.
model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  currency        String      @default("USD")
  subtotal        Float
  shipping        Float       @default(0)
  total           Float
  shippingDetails Json?
  paidAt          DateTime?
  // Admin manual override of the tracking stage — when set, overrides the
  // automatic time-based simulation in tracking.ts.
  manualStage     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Set on the original prepay order AND every later auto-created monthly
  // shipment order for a "recurring" Subscription B plan — lets the admin
  // trace every shipment back to the plan it belongs to.
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  qty            Int
  price          Float
  isSubscription Boolean @default(false)
  variantName    String?
}

// "Subscription A" — a standing, reusable discount unlocked on ONE specific
// product once the customer has bought it at full price. Applied via the
// `code` at checkout (not auto-detected from the account) so it works
// identically for a web order or an Instagram DM order a staff member
// enters manually — the code is the one thing that travels across both
// channels. Reusable indefinitely, not single-use: "every purchase after
// the first one" per the business rule this implements.
model ProductSubscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  code            String   @unique
  discountPercent Float
  // The order that qualified the customer for this (their first, full-price
  // purchase of this product) — informational, not required for redemption.
  firstOrderId    String?
  createdAt       DateTime @default(now())

  @@unique([userId, productId])
}

enum SubscriptionTerm {
  THREE_MONTH
  SIX_MONTH
  TWELVE_MONTH
}

enum SubscriptionPlanStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

// "Subscription B" — a prepaid multi-month plan (3/6/12 months) at a
// bigger, term-scaled discount, charged as one upfront payment. Both
// `fulfillmentMode` and `discountPercent` are snapshotted from the admin's
// settings at the moment of purchase, so a later admin change never
// retroactively alters an already-active plan.
model SubscriptionPlan {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  term    SubscriptionTerm
  // "immediate" (the whole term ships in this one order) or "recurring"
  // (ships one month at a time — see jobs/subscriptionShipments.ts).
  fulfillmentMode String
  // [{ slug, name, qtyPerMonth }] — what they subscribed to and at what
  // monthly quantity; the basis for the cost/discount calculation.
  items              Json
  discountPercent    Float
  totalPaid          Float
  status             SubscriptionPlanStatus @default(ACTIVE)
  // The Order that captured the upfront payment (for "immediate", also the
  // order carrying the full shipped quantity).
  orderId            String?
  // Only meaningful for "recurring": how many more monthly shipments are
  // owed, and when the next one is due. Both null/0 for "immediate".
  remainingShipments Int                    @default(0)
  nextShipmentDate   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  orders Order[]
}

model ConsultationRequest {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String?
  skinConcern   String
  preferredDate DateTime?
  message       String?
  status        String    @default("NEW")
  createdAt     DateTime  @default(now())
}

model WholesaleInquiry {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String?
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A log of admin-sent email blasts — not a scheduler, just a record.
model EmailCampaign {
  id             String   @id @default(cuid())
  subject        String
  html           String
  recipientCount Int
  // "subscribers" (newsletter opt-ins) or "allUsers" (every registered
  // account) — which list this send actually went to.
  audience       String   @default("subscribers")
  createdAt      DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// Schema only for now — populated once the Paystack phase is built.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("paystack")
  providerReference String?       @unique
  amount            Float
  currency          String
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
}

// Manual admin-entered expense/income lines for the budget tracker (later phase).
model BudgetEntry {
  id          String   @id @default(cuid())
  label       String
  amount      Float
  type        String // "income" | "expense"
  note        String?
  createdAt   DateTime @default(now())
}
